# Valeurs de référence pour le déploiement prod sur le serveur homelab.
# Copier en `.env`, remplir, puis `chmod 600 .env`.
# Ne jamais réutiliser les mots de passe de dev (.env local).
#
# Ports hôte déjà pris sur ce serveur à NE PAS réutiliser :
# 5432 (postgres global), 5678 (n8n), 8000/9443 (portainer),
# 8443 (azwebsite), 8444 (myportfolio), 8445 (video-dl-sass).
# SmartStock (frontend prod) utilise 8446.

# --- auth-db ---
AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=

# --- inventory-db ---
INVENTORY_DB_NAME=inventory
INVENTORY_DB_USER=inventory
INVENTORY_DB_PASSWORD=

# --- order-db ---
ORDER_DB_NAME=orders
ORDER_DB_USER=orders
ORDER_DB_PASSWORD=

# --- Secret interne order-service -> inventory-service (endpoint de lot).
# Générer : openssl rand -base64 48 (32 caractères minimum).
INTERNAL_API_TOKEN=

# --- Auth / JWT (RS256 — auth-service signe, gateway vérifiera à terme) ---
# Clés RSA à générer avec ./scripts/generate-jwt-keys.sh (non commitées).
JWT_ISSUER=smartstock-auth
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

# --- Compte SuperAdmin de bootstrap (créé au premier démarrage si la table
# users est vide — voir auth-service DataSeeder). Changer le mot de passe
# après le premier login. ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@smartstock.local
ADMIN_PASSWORD=

# --- CORS --- nginx sert l'application ET proxifie /api/ sur la même
# origine (les services reconstruisent l'URL publique via X-Forwarded-*),
# donc ceci ne sert que si quelque chose appelle l'API depuis un autre
# domaine.
CORS_ALLOWED_ORIGINS=https://smart-stock.azwebtech.net

# --- Frontend (port hôte publié par nginx, 127.0.0.1 + IP Tailscale) ---
FRONTEND_PORT=8446
# IP Tailscale de cet hôte (déjà 100.103.213.104 pour les autres projets
# ici — à changer seulement si l'hôte change).
TAILSCALE_IP=100.103.213.104
