# Copier en .env et remplir avant `docker compose up`.
# Ports hôte déjà pris dans le homelab à NE PAS réutiliser :
# 5432 (postgres global), 5678 (n8n), 8000/9443 (portainer),
# 8443 (azwebsite), 8444 (myportfolio).

# --- auth-db ---
AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=change-me

# --- inventory-db ---
INVENTORY_DB_NAME=inventory
INVENTORY_DB_USER=inventory
INVENTORY_DB_PASSWORD=change-me

# --- order-db ---
ORDER_DB_NAME=orders
ORDER_DB_USER=orders
ORDER_DB_PASSWORD=change-me

# --- billing-db ---
BILLING_DB_NAME=billing
BILLING_DB_USER=billing
BILLING_DB_PASSWORD=change-me

# --- notification-db ---
NOTIFICATION_DB_NAME=notification
NOTIFICATION_DB_USER=notification
NOTIFICATION_DB_PASSWORD=change-me

# --- Auth / JWT (RS256 — auth-service signe, gateway vérifie) ---
# Clés RSA à générer avec ./scripts/generate-jwt-keys.sh (non commitées).
JWT_ISSUER=smartstock-auth
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=2592000000

# --- Compte SuperAdmin de bootstrap (créé au premier démarrage si la table
# users est vide — voir auth-service DataSeeder) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@smartstock.local
ADMIN_PASSWORD=change-me

# --- CORS (origines autorisées à appeler l'API depuis un navigateur) ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Frontend (port hôte exposé par nginx) ---
FRONTEND_PORT=8446
